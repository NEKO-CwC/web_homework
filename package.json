{
  "name": "minimal-mall",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm --filter @minimal-mall/storefront dev",
    "build": "pnpm --filter @minimal-mall/storefront build",
    "lint": "pnpm --filter @minimal-mall/storefront lint",
    "typecheck": "pnpm --filter @minimal-mall/storefront typecheck && pnpm --filter @minimal-mall/db typecheck && pnpm --filter @minimal-mall/auth typecheck",
    "test": "pnpm --filter @minimal-mall/storefront test && pnpm --filter @minimal-mall/auth test && pnpm --filter @minimal-mall/db test",
    "test:coverage": "pnpm --filter @minimal-mall/storefront test:coverage && pnpm --filter @minimal-mall/auth test:coverage",
    "e2e": "pnpm --filter @minimal-mall/storefront e2e",
    "ui:screenshots": "pnpm --filter @minimal-mall/storefront ui:screenshots",
    "performance": "pnpm --filter @minimal-mall/storefront performance",
    "prisma:generate": "pnpm --filter @minimal-mall/db prisma:generate",
    "prisma:migrate": "pnpm --filter @minimal-mall/db prisma:migrate",
    "db:seed": "pnpm --filter @minimal-mall/db db:seed",
    "db:verify": "pnpm --filter @minimal-mall/db db:verify",
    "prisma:smoke": "pnpm --filter @minimal-mall/storefront prisma:smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.28.0",
    "prisma": "^6.10.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
