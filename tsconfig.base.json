{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@minimal-mall/db": ["packages/db/src/index.ts"],
      "@minimal-mall/types": ["packages/types/src/index.ts"],
      "@minimal-mall/ui": ["packages/ui/src/index.tsx"],
      "@minimal-mall/auth": ["packages/auth/src/index.ts"]
    }
  }
}
